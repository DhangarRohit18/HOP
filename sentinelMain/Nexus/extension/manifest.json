{
  "manifest_version": 3,
  "name": "NEXUS Contextual Operational Intelligence",
  "version": "1.0.0",
  "description": "Contextual disruption intelligence and recovery simulation layer for enterprise operational portals.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NEXUS Contextual Intelligence"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  }
}
