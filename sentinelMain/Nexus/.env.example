# ==============================================================================
# NEXUS Autonomous Disruption Control Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_DB=nexus_db
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=nexus_secret_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nexus_admin:nexus_secret_pass@localhost:5432/nexus_db

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Provider Integration (AI Reasoning Layer)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here
LLM_TEMPERATURE=0.0

# Governed Autonomy Settings (Levels 0-3)
DEFAULT_AUTONOMY_LEVEL=1  # 0: Observe, 1: Recommend, 2: Prepare, 3: Execute
MAX_AUTO_APPROVAL_COST_USD=10000.00
HIGH_RISK_ESCALATION_REQUIRED=true

# Simulation & Determinism Controls
SIMULATION_DEFAULT_SEED=42
SIMULATION_MAX_HORIZON_DAYS=30

# Feature Flags
ENABLE_CHAOS_ENGINE=false
ENABLE_AUTOMATED_REPLANNING=true
