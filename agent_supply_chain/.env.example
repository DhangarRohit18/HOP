# SupplyShield 3D — Autonomous Automotive Digital Twin Environment Config

# SambaNova Cloud API Configuration (Keep secret on backend)
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_MODEL=Meta-Llama-3.1-8B-Instruct

# Server Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=sqlite:///./supplyshield.db
# DATABASE_URL=postgresql://user:password@localhost:5432/supplyshield_db

# Autonomous Control Configuration
AUTONOMOUS_APPROVAL_THRESHOLD=150000.0
